/**
 * SERVER-SIDE GATE — NOT ENABLED. See CLAUDE.md §4.4.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS FILE EXISTS
 * ---------------------------------------------------------------------------
 *
 * The shipped gate (`src/lib/gate.ts`, `src/components/gate/`) runs in the
 * browser. It deters casual sharing of a URL; it does not protect secrets,
 * because the page content is delivered to every visitor regardless. See
 * SECURITY.md.
 *
 * This middleware is the upgrade. With it enabled, an unauthenticated request
 * never receives page content at all — the Edge runtime returns the passphrase
 * form instead, and the passphrase itself never reaches the client bundle.
 *
 * ---------------------------------------------------------------------------
 * TO ENABLE — about fifteen minutes
 * ---------------------------------------------------------------------------
 *
 *   1. Rename this file to `src/middleware.ts`.
 *   2. Replace `NEXT_PUBLIC_GATE_HASH` with two SERVER-ONLY env vars, in
 *      `.env.local` and in the Vercel project settings:
 *
 *          GATE_PASSWORD=<the passphrase, in plaintext>
 *          GATE_SECRET=<32+ random bytes, e.g. `openssl rand -hex 32`>
 *
 *      Note the missing NEXT_PUBLIC_ prefix — that is the entire point. These
 *      are never inlined into the browser bundle.
 *   3. Delete `NEXT_PUBLIC_GATE_HASH` from `.env.local`, from `.env.example`
 *      and from Vercel.
 *   4. Remove <GateProvider> from `src/app/layout.tsx` and delete
 *      `src/components/gate/` and `src/lib/gate.ts`. Leaving the client gate in
 *      place is harmless but redundant, and it will prompt a second time.
 *   5. Update SECURITY.md, which currently states the opposite.
 *
 * The cookie is an HMAC over an expiry timestamp, so it cannot be forged
 * without GATE_SECRET and it expires on its own. Verification is constant-time.
 */

import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

const COOKIE = 'sunrey_access';
const TTL_MS = 30 * 24 * 60 * 60 * 1000; // 30 days, matching the client gate

function bytes(value: string): Uint8Array {
  return new TextEncoder().encode(value);
}

function toHex(buffer: ArrayBuffer): string {
  return Array.from(new Uint8Array(buffer))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
}

async function sign(payload: string, secret: string): Promise<string> {
  const key = await crypto.subtle.importKey(
    'raw',
    bytes(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign'],
  );
  return toHex(await crypto.subtle.sign('HMAC', key, bytes(payload)));
}

/** Length-independent, branch-free comparison. */
function timingSafeEqual(a: string, b: string): boolean {
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i += 1) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

async function isAuthorised(request: NextRequest, secret: string): Promise<boolean> {
  const raw = request.cookies.get(COOKIE)?.value;
  if (!raw) return false;
  const [expires, signature] = raw.split('.');
  if (!expires || !signature) return false;
  if (Number(expires) < Date.now()) return false;
  return timingSafeEqual(signature, await sign(expires, secret));
}

function form(message?: string): Response {
  // Inline, self-contained, and carrying no site content.
  return new Response(
    `<!doctype html><html lang="en"><head><meta charset="utf-8">
     <meta name="viewport" content="width=device-width,initial-scale=1">
     <meta name="robots" content="noindex,nofollow"><title>SunRey</title>
     <style>
       :root{color-scheme:dark}
       body{margin:0;min-height:100vh;display:grid;place-items:center;background:#030303;
            color:#F6F3ED;font:400 16px/1.7 system-ui,sans-serif;
            background-image:radial-gradient(60% 50% at 50% 0%,rgba(227,178,60,.20) 0%,rgba(227,178,60,.05) 45%,transparent 75%)}
       form{display:flex;flex-direction:column;gap:16px;align-items:center;width:min(30rem,90vw)}
       input{width:100%;padding:12px 20px;border-radius:999px;text-align:center;
             border:1px solid rgba(246,243,237,.09);background:rgba(6,5,5,.6);color:#F6F3ED;font:inherit}
       button{padding:10px 24px;border-radius:999px;border:1px solid rgba(227,178,60,.28);
              background:none;color:#E3B23C;font:500 12px/1.4 ui-monospace,monospace;
              letter-spacing:.18em;text-transform:uppercase;cursor:pointer}
       :focus-visible{outline:2px solid #E3B23C;outline-offset:3px}
       p{min-height:20px;font-size:12px;color:#F0D68B;margin:0}
     </style></head>
     <body><form method="POST"><label for="p" style="position:absolute;width:1px;height:1px;
       overflow:hidden;clip:rect(0 0 0 0)">Passphrase</label>
       <input id="p" name="passphrase" type="password" autocomplete="current-password" autofocus>
       <button type="submit">Enter</button>
       <p role="status" aria-live="polite">${message ?? ''}</p>
     </form></body></html>`,
    { status: message ? 401 : 200, headers: { 'content-type': 'text/html; charset=utf-8' } },
  );
}

export async function middleware(request: NextRequest) {
  const password = process.env.GATE_PASSWORD;
  const secret = process.env.GATE_SECRET;

  // Fail closed. A missing env var must never mean "let everyone in".
  if (!password || !secret) {
    return new Response('Access is not configured.', { status: 503 });
  }

  if (await isAuthorised(request, secret)) return NextResponse.next();

  if (request.method === 'POST') {
    const submitted = (await request.formData()).get('passphrase');
    if (typeof submitted === 'string' && timingSafeEqual(submitted.trim(), password)) {
      const expires = String(Date.now() + TTL_MS);
      const response = NextResponse.redirect(new URL(request.nextUrl.pathname, request.url), 303);
      response.cookies.set(COOKIE, `${expires}.${await sign(expires, secret)}`, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: TTL_MS / 1000,
      });
      return response;
    }
    return form('That passphrase is not recognized.');
  }

  return form();
}

export const config = {
  // Everything except Next's own assets. `_next/static` must stay open or the
  // form's own response cannot be styled, and favicons should not 401.
  matcher: ['/((?!_next/static|_next/image|favicon|robots.txt).*)'],
};
