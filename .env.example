# The access gate — CLAUDE.md §4.3.
#
# Both variables are set as ENCRYPTED environment variables in the Cloudflare
# Pages project, for Production and Preview. Neither is ever committed, and
# neither is NEXT_PUBLIC_ — they are read only by the Pages Function, which
# runs before any file is served.
#
# Rotating GATE_PASSWORD takes effect on the next request, with no rebuild.
# Rotating GATE_SECRET additionally signs every existing session out, which is
# how you evict everyone at once.

# The shared passphrase.
GATE_PASSWORD=

# 32 random bytes, hex. Generate with:  openssl rand -hex 32
GATE_SECRET=
